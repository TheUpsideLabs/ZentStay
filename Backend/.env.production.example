# ==========================================
# ZENTSTAY BACKEND - PRODUCTION ENVIRONMENT
# ==========================================

PORT=5000
NODE_ENV=production

# Managed PostgreSQL URL (e.g. AWS RDS, Supabase, Neon, Railway)
DATABASE_URL="postgresql://user:password@host:5432/zentstay_prod?sslmode=require"

# JWT Security Secrets (Generate using `openssl rand -hex 32`)
JWT_ACCESS_SECRET="generate_strong_access_secret_here"
JWT_REFRESH_SECRET="generate_strong_refresh_secret_here"

# Frontend URL for CORS Security Lockdown
FRONTEND_URL="https://your-zentstay-frontend.vercel.app"

# Cloudinary CDN Configuration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Payment Gateways (Currently Frozen per PRD v1.0)
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
